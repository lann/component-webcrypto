{
  "name": "@lann/conformance-jco-webcrypto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jco conformance adapters (Node + headless browser) for lann:webcrypto: transpile the shared conformance guest against the browser-first host (jco-impl/webcrypto.js) and emit the per-target results JSON the conformance runner consumes.",
  "scripts": {
    "transpile": "jco transpile ../../guest/build/conformance-guest.component.wasm --name conformance-guest --async-mode jspi --async-exports 'conformance:webcrypto/tests@0.1.0#run-all' --async-exports 'conformance:webcrypto/tests@0.1.0#run-slice' --async-exports 'conformance:webcrypto/tests@0.1.0#run-many' --async-imports 'lann:webcrypto/hmac@0.1.0#import-hmac-sha256-key' --async-imports 'lann:webcrypto/hmac@0.1.0#generate-hmac-sha256-key' --async-imports 'lann:webcrypto/aes-gcm@0.1.0#import-aes256-gcm-key' --async-imports 'lann:webcrypto/aes-gcm@0.1.0#generate-aes256-gcm-key' --async-imports 'lann:webcrypto/mac@0.1.0#[method]mac-key.sign' --async-imports 'lann:webcrypto/mac@0.1.0#[method]mac-key.verify' --async-imports 'lann:webcrypto/mac@0.1.0#[method]mac-key.export' --async-imports 'lann:webcrypto/aead@0.1.0#[method]aead-key.seal' --async-imports 'lann:webcrypto/aead@0.1.0#[method]aead-key.open' --async-imports 'lann:webcrypto/aead@0.1.0#[method]aead-key.export' --map 'lann:webcrypto/mac@0.1.0=../../../../jco-impl/webcrypto.js' --map 'lann:webcrypto/aead@0.1.0=../../../../jco-impl/webcrypto.js' --map 'lann:webcrypto/hmac@0.1.0=../../../../jco-impl/webcrypto.js' --map 'lann:webcrypto/aes-gcm@0.1.0=../../../../jco-impl/webcrypto.js' -o generated",
    "run:node": "node --experimental-wasm-jspi src/run-node.mjs",
    "run:browser": "node src/run-browser.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.19.0",
    "playwright-core": "^1.61.1"
  },
  "overrides": {
    "@bytecodealliance/jco-transpile": "0.5.0"
  }
}
