# component-test conformance recipes. Module recipes run from this
# directory (conformance/driver-ct); `root` is the repo root. The
# component-test checkout lives as a sibling of the repo, pinned by
# .component-test-rev (CI clones and checks out that rev; locally,
# keep the sibling at or past the pin). Publishing component-test to
# registries replaces this arrangement eventually.

root := "../.."
ct-tree := root + "/../component-test"
# The component-test CLI and generic runner are invoked as prebuilt
# binaries from the sibling checkout's bin/ (populated by _ct-tools;
# CI caches that directory keyed on .component-test-rev, so runs skip
# both the build and the ~2 min of rebuild/relink cargo pays on a
# fresh clone even with a cached target dir).
ct := ct-tree + "/bin/component-test"
ct-runner := ct-tree + "/bin/ct-runner"
guest := root + "/target/wasm32-wasip2/release/conformance_guest_ct.wasm"
signing := root + "/target/wasm32-wasip2/release/conformance_signing_guest_ct.wasm"
provider := root + "/target/wasm32-wasip2/release/lann_webcrypto_guest_provider.wasm"
composed := root + "/target/conformance-composed-ct.wasm"

# CI/opt-in predicate for the optional jco-browser target: non-empty when
# it should run — always under GitHub Actions (the runner image ships
# Chrome), locally only with CONFORMANCE_BROWSER=1 (the incumbent's
# conformance-browser-enabled convention; see justfile.shared.just).
conformance-browser-enabled := if env('GITHUB_ACTIONS', '') == 'true' { '1' } else if env('CONFORMANCE_BROWSER', '') == '1' { '1' } else { '' }

# Build both suite components (rkyv corpus) and the host driver.
# CONFORMANCE_PREBUILT=1 skips cargo when the artifacts are already
# present — set by CI on an exact-source-hash cache hit (see the
# conformance job's "Cache conformance artifacts" step), never locally.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "${CONFORMANCE_PREBUILT:-}" = "1" ] && [ -f "{{guest}}" ] && [ -f "{{signing}}" ] \
        && [ -x "{{root}}/target/release/ct-driver" ]; then
        echo "conformance suite/driver artifacts are prebuilt (CONFORMANCE_PREBUILT=1); skipping cargo"
        exit 0
    fi
    cargo build --manifest-path {{root}}/Cargo.toml --target wasm32-wasip2 --release \
        -p conformance-guest-ct -p conformance-signing-guest-ct \
        --features conformance-guest-ct/rkyv-corpus
    cargo build --manifest-path {{root}}/Cargo.toml --release -p conformance-driver-ct

# Populate the sibling checkout's bin/ with the component-test CLI and
# the generic runner. Reused when the binaries exist and match the
# sibling's HEAD; a dirty sibling tree always rebuilds (local iteration
# on component-test itself). --release is load-bearing: the runner
# embeds wasmtime, and a dev-profile Cranelift + host runs the composed
# corpus ~16x slower (~5 min vs ~19 s), which blew CI's job timeout.
_ct-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    tree="{{ct-tree}}"
    rev=$(git -C "$tree" rev-parse HEAD)
    # Tracked modifications only (-uno): bin/ itself (and target/) live
    # untracked inside the checkout and must not count as dirt, or the
    # reuse check can never pass.
    dirty=$(git -C "$tree" status --porcelain -uno)
    if [ -z "$dirty" ] && [ -x "$tree/bin/component-test" ] && [ -x "$tree/bin/ct-runner" ] \
        && [ "$(cat "$tree/bin/.rev" 2>/dev/null)" = "$rev" ]; then
        exit 0
    fi
    cargo build -q --release --manifest-path "$tree/Cargo.toml" \
        -p component-test-cli -p component-test-runner
    mkdir -p "$tree/bin"
    cp "$tree/target/release/component-test" "$tree/target/release/ct-runner" "$tree/bin/"
    if [ -z "$dirty" ]; then printf '%s' "$rev" > "$tree/bin/.rev"; else rm -f "$tree/bin/.rev"; fi

# Drift-check the committed lockfiles.
lock-check: build _ct-tools
    {{ct}} lock {{guest}} --check ../guest-ct/tests.lock
    {{ct}} lock {{signing}} --check ../signing-guest-ct/tests.lock

# Regenerate lockfiles after case changes (commit the diff).
lock-update: build _ct-tools
    {{ct}} lock {{guest}} -o ../guest-ct/tests.lock
    {{ct}} lock {{signing}} -o ../signing-guest-ct/tests.lock

# The wasmtime (RustCrypto) target: full support.
run-wasmtime: build
    mkdir -p results
    {{root}}/target/release/ct-driver {{guest}} --jobs 8 --jsonl \
        --target wasmtime-rustcrypto > results/wasmtime-rustcrypto.jsonl
    {{root}}/target/release/ct-driver {{signing}} --jsonl \
        --target wasmtime-rustcrypto > results/wasmtime-signing.jsonl

# The jco npm tree + both transpiles, skipped when up to date. The
# guard is a content stamp (sha256 of both guest wasms, recorded in
# generated/.stamp), not mtimes — mtimes lie under CI's artifact cache
# and race across processes. The whole body holds a flock so the
# parallel phase's standalone invocations (run-jco and run-browser both
# depend on this) serialize: the first does the work, the second sees a
# fresh stamp and no-ops.
_jco-prepared: build
    #!/usr/bin/env bash
    set -euo pipefail
    # Stamp before cd: {{guest}}/{{signing}} are valid from the recipe
    # cwd but not from jco/ — and not always relative: module-from-root
    # invocation resolves `root` absolute (justfile.shared.just), while
    # in-directory invocation leaves it `../..`. Never re-anchor these
    # variables with a textual prefix.
    stamp=$(cat "{{guest}}" "{{signing}}" | sha256sum | cut -d' ' -f1)
    cd jco
    exec 9> .prepare.lock
    flock 9
    if [ package-lock.json -nt node_modules/.package-lock.json ]; then
        npm install --silent
    fi
    if [ "$(cat generated/.stamp 2>/dev/null || true)" != "$stamp" ]; then
        npm run --silent transpile
        npm run --silent transpile:signing
        printf '%s' "$stamp" > generated/.stamp
    fi

# The jco-node target (browser-first host under Node/JSPI), both suites:
# Node's WebCrypto serves the gated RSA private-key mints by default (the
# fail-closed policy is a browser posture), so the signing suite declares
# nothing missing here.
run-jco: build _jco-prepared
    mkdir -p results
    cd jco && node --experimental-wasm-jspi runner.mjs \
        --missing sha1-checked --jsonl --target jco-node \
        > ../results/jco-node.jsonl
    cd jco && node --experimental-wasm-jspi runner.mjs \
        --suite conformance-signing-guest-ct --jsonl --target jco-node \
        > ../results/jco-node-signing.jsonl

# Build the in-guest RustCrypto provider (composed target SUT; also the
# class-D gate's plug). Prebuilt-skip as for `build`.
build-provider:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "${CONFORMANCE_PREBUILT:-}" = "1" ] && [ -f "{{provider}}" ]; then
        echo "the in-guest provider artifact is prebuilt (CONFORMANCE_PREBUILT=1); skipping cargo"
        exit 0
    fi
    cargo build --manifest-path {{root}}/Cargo.toml --release \
        -p lann-webcrypto-guest-provider --target wasm32-wasip2

# The composed target: the shared suite plugged with the in-guest
# RustCrypto provider, run under the GENERIC component-test host runner
# (ct-runner provides only wasi + test-context — exactly the composed
# artifact's imports; the leftover lann:webcrypto/{types,aes,rsa} imports
# are type-only and instantiate trivially). The provider exports every
# gated interface the suite imports (sha1-checked); its one gap is class
# D's ecdsa-sign,
# which nothing in the shared suite is tagged with — declared for the
# aggregate's cross-check against targets.toml. The signing suite never
# runs composed: its world imports ecdsa-sign, so it cannot even link
# against the provider (the class-d recipe asserts exactly that).
run-composed: build build-provider _ct-tools
    mkdir -p results
    wac plug {{guest}} --plug {{provider}} -o {{composed}}
    {{ct-runner}} {{composed}} --jobs 8 --jsonl \
        --suite-artifact {{guest}} \
        --missing ecdsa-sign --target composed > results/composed.jsonl

# The jco-browser target: the same transpiles and the same host module,
# with the case loop running inside headless Chromium (browser WebCrypto)
# via the shared page driver (scripts/browser-page-driver.mjs). The
# --missing declarations mirror targets.toml / targets-signing.toml's
# jco-browser entries, which the aggregate cross-checks: the browser
# cannot serve sha1-checked, and the host fails the gated RSA
# private-key mints closed outside Node (targets-signing.toml).
run-browser: build _jco-prepared
    mkdir -p results
    cd jco && node run-browser.mjs \
        --missing sha1-checked \
        --missing-signing rsa-sign,rsa-oaep-decrypt

# run-browser when enabled (CI, or CONFORMANCE_BROWSER=1); a skip note
# otherwise — targets.toml marks jco-browser optional, so the aggregates
# warn on its missing results rather than failing.
_run-browser-if-enabled:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "{{conformance-browser-enabled}}" ]; then
        just run-browser
    else
        rm -f results/jco-browser.jsonl results/jco-browser-signing.jsonl
        echo "skipping the jco-browser conformance target (opt in with CONFORMANCE_BROWSER=1; needs Chrome/Chromium 137+)"
    fi

# Aggregate all targets into the matrix; exits nonzero on any failure
# or validation error. Binds against the COMMITTED lockfiles: upstream
# ruled (lann/component-test#44) that artifact hashes are provenance,
# never a cross-environment gate, so the committed inventory — whose
# diff is the review surface — is what results aggregate against; no
# fresh-lock indirection. The optional jco-browser results are included
# when present (their absence is a declared warning, not an error).
aggregate: _ct-tools
    #!/usr/bin/env bash
    set -euo pipefail
    browser=()
    [ -f results/jco-browser.jsonl ] && browser=(--results jco-browser=results/jco-browser.jsonl)
    {{ct}} aggregate \
        --lock ../guest-ct/tests.lock \
        --manifest targets.toml \
        --results wasmtime-rustcrypto=results/wasmtime-rustcrypto.jsonl \
        --results composed=results/composed.jsonl \
        --results jco-node=results/jco-node.jsonl \
        ${browser[@]+"${browser[@]}"} \
        -o results/matrix.md

# The signing suite (host-only: wasmtime, jco-node, and jco-browser).
aggregate-signing: _ct-tools
    #!/usr/bin/env bash
    set -euo pipefail
    browser=()
    [ -f results/jco-browser-signing.jsonl ] && browser=(--results jco-browser=results/jco-browser-signing.jsonl)
    {{ct}} aggregate \
        --lock ../signing-guest-ct/tests.lock \
        --manifest targets-signing.toml \
        --results wasmtime-rustcrypto=results/wasmtime-signing.jsonl \
        --results jco-node=results/jco-node-signing.jsonl \
        ${browser[@]+"${browser[@]}"} \
        -o results/matrix-signing.md

# Refresh the committed matrices from a FULL run (all targets incl.
# browser: CONFORMANCE_BROWSER=1 just conformance-ct::all first).
# Commit the diff - like lockfiles, the diff is the review surface.
matrix-update:
    cp results/matrix.md matrix.md
    cp results/matrix-signing.md matrix-signing.md

# CI (which always runs the browser leg) verifies the committed
# matrices match the run.
matrix-check:
    diff -u matrix.md results/matrix.md
    diff -u matrix-signing.md results/matrix-signing.md

# Everything: build, then every check and target in parallel (the
# incumbent gate's topology: wall time is bounded by the slowest
# target, not the sum). The pre-phase builds everything the parallel
# recipes share — artifacts, tools, npm tree, transpiles — so they are
# independent by the parallel-recipes.sh contract; each also names its
# deps for standalone use, where the guards make the re-runs no-ops.
# Aggregates run after: they read every target's results.
all: build build-provider _ct-tools _jco-prepared
    cd {{root}} && scripts/parallel-recipes.sh target/conformance-ct-logs \
        conformance-ct::lock-check conformance-ct::class-d \
        conformance-ct::run-wasmtime conformance-ct::run-composed \
        conformance-ct::run-jco conformance-ct::_run-browser-if-enabled
    just aggregate aggregate-signing

# The class-D negative-composition gate (ported from the incumbent
# harness), in two halves.
#
# First: composing a consumer whose world imports `ecdsa-sign` (the
# signing suite) with the in-guest provider must fail. This is what makes
# "class D is enforced structurally" a fact rather than a claim — without
# it, the provider could start exporting `ecdsa-sign` and every other
# check would still report green, because targets-signing.toml excludes
# everything but the wasmtime target by declaration.
#
# The composition fails on a resource-type mismatch, not on an unsatisfied
# import: `wac plug` leaves imports it cannot satisfy in place. `ecdsa-sign`
# does `use signature.{signing-key}`, and the provider *does* export
# `signature`, so plugging rebinds `signing-key` to the provider's own
# resource and orphans the `ecdsa-sign` import that still names the
# imported one. The enforcement therefore holds only while the provider
# exports the generic interface whose resource the withheld minting
# interface mints — true of every minting interface in the package today.
#
# Second: the same assertion for each other withheld minting interface —
# `rsa-oaep-decrypt`, `rsassa-pkcs1-v15-sign`, `rsa-pss-sign`, and
# `rsa-oaep-encrypt` — which the signing suite cannot prove: its
# composition already fails on `ecdsa-sign`, so a provider that wrongly
# started exporting one of the others would still fail that composition
# for an unrelated reason. Each withheld interface has a dedicated minimal
# probe world under ../class-d/ importing nothing withheld but that
# interface (no Rust crates — `wasm-tools component embed --dummy` stubs
# each core). Every probe must fail to compose, on the resources its own
# interface `use`s from the generic interface the provider exports
# (`signature` for the sign probes, kind-only `public-encryption` for the
# OAEP ones).
#
# Matching each message on its interface name is load-bearing: a gate that
# accepted any nonzero exit would also pass on a missing artifact or a
# changed `wac` CLI.
class-d: build build-provider
    #!/usr/bin/env bash
    set -uo pipefail
    output=$(wac plug {{signing}} \
        --plug '{{root}}/target/wasm32-wasip2/release/lann_webcrypto_guest_provider.wasm' \
        -o '{{root}}/target/class-d-composition.wasm' 2>&1)
    status=$?
    if [ $status -eq 0 ]; then
        echo "class-D gate: composing the signing suite with the in-guest provider SUCCEEDED." >&2
        echo "The provider must not export lann:webcrypto/ecdsa-sign (rust/guest-provider/wit/world.wit)." >&2
        exit 1
    fi
    if ! printf '%s' "$output" | grep -q 'lann:webcrypto/ecdsa-sign'; then
        echo "class-D gate: the composition failed, but not on ecdsa-sign:" >&2
        printf '%s\n' "$output" >&2
        exit 1
    fi
    echo "class-D gate: the signing suite does not compose with the in-guest provider (ecdsa-sign is not exported)."
    provider='{{root}}/target/wasm32-wasip2/release/lann_webcrypto_guest_provider.wasm'
    probes=(
        'oaep-probe|rsa-oaep-decrypt|--features rsa-oaep-decrypt'
        'rsassa-sign-probe|rsassa-pkcs1-v15-sign|--features rsa-sign'
        'pss-sign-probe|rsa-pss-sign|--features rsa-sign'
        'oaep-encrypt-probe|rsa-oaep-encrypt|'
    )
    for probe in "${probes[@]}"; do
        IFS='|' read -r world iface features <<< "$probe"
        set -e
        wasm-tools component embed --dummy $features \
            -w "$world" "../class-d/$world/wit" \
            -o "{{root}}/target/class-d-$world.core.wasm"
        wasm-tools component new "{{root}}/target/class-d-$world.core.wasm" \
            -o "{{root}}/target/class-d-$world.wasm"
        set +e
        output=$(wac plug "{{root}}/target/class-d-$world.wasm" \
            --plug "$provider" \
            -o "{{root}}/target/class-d-$world-composition.wasm" 2>&1)
        status=$?
        if [ $status -eq 0 ]; then
            echo "class-D gate: composing the $iface probe with the in-guest provider SUCCEEDED." >&2
            echo "The provider must not export lann:webcrypto/$iface (rust/guest-provider/wit/world.wit)." >&2
            exit 1
        fi
        if ! printf '%s' "$output" | grep -q "lann:webcrypto/$iface"; then
            echo "class-D gate: the $iface probe composition failed, but not on $iface:" >&2
            printf '%s\n' "$output" >&2
            exit 1
        fi
        echo "class-D gate: the $iface probe does not compose with the in-guest provider ($iface is not exported)."
    done
