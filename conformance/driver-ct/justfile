# component-test conformance recipes (M1.6). Module recipes run from
# this directory (conformance/driver-ct); `root` is the repo root. The
# component-test checkout is expected as a sibling of the repo during
# the migration.

root := "../.."
ct := "cargo run -q --manifest-path " + root + "/../component-test/Cargo.toml -p component-test-cli --"
guest := root + "/target/wasm32-wasip2/release/conformance_guest_ct.wasm"
signing := root + "/target/wasm32-wasip2/release/conformance_signing_guest_ct.wasm"

# Build both suite components (rkyv corpus) and the host driver.
build:
    cargo build --manifest-path {{root}}/Cargo.toml --target wasm32-wasip2 --release \
        -p conformance-guest-ct -p conformance-signing-guest-ct \
        --features conformance-guest-ct/rkyv-corpus
    cargo build --manifest-path {{root}}/Cargo.toml --release -p conformance-driver-ct

# Drift-check the committed lockfiles.
lock-check: build
    {{ct}} lock {{guest}} --check ../guest-ct/tests.lock
    {{ct}} lock {{signing}} --check ../signing-guest-ct/tests.lock

# Regenerate lockfiles after case changes (commit the diff).
lock-update: build
    {{ct}} lock {{guest}} -o ../guest-ct/tests.lock
    {{ct}} lock {{signing}} -o ../signing-guest-ct/tests.lock

# The wasmtime (RustCrypto) target: full support.
run-wasmtime: build
    mkdir -p results
    {{root}}/target/release/ct-driver {{guest}} --jobs 8 --jsonl \
        --target wasmtime-rustcrypto > results/wasmtime-rustcrypto.jsonl
    {{root}}/target/release/ct-driver {{signing}} --jsonl \
        --target wasmtime-rustcrypto > results/wasmtime-signing.jsonl

# The jco-node target (browser-first host under Node/JSPI).
run-jco: build
    mkdir -p results
    cd jco && npm install --silent && npm run transpile
    cd jco && node --experimental-wasm-jspi runner.mjs \
        --missing xchacha20-poly1305,sha1-checked --jsonl --target jco-node \
        > ../results/jco-node.jsonl

# Aggregate all targets into the matrix; exits nonzero on any failure
# or validation error.
aggregate:
    {{ct}} aggregate \
        --lock ../guest-ct/tests.lock \
        --manifest targets.toml \
        --results wasmtime-rustcrypto=results/wasmtime-rustcrypto.jsonl \
        --results jco-node=results/jco-node.jsonl \
        -o matrix.md

# The signing suite (host-only; wasmtime target).
aggregate-signing:
    {{ct}} aggregate \
        --lock ../signing-guest-ct/tests.lock \
        --manifest targets-signing.toml \
        --results wasmtime-rustcrypto=results/wasmtime-signing.jsonl \
        -o matrix-signing.md

# Everything: build, lock-check, class-D gate, both targets, aggregates.
all: lock-check class-d run-wasmtime run-jco aggregate aggregate-signing

# The class-D negative-composition gate (ported from the incumbent
# harness), in two halves.
#
# First: composing a consumer whose world imports `ecdsa-sign` (the
# signing suite) with the in-guest provider must fail. This is what makes
# "class D is enforced structurally" a fact rather than a claim — without
# it, the provider could start exporting `ecdsa-sign` and every other
# check would still report green, because targets-signing.toml excludes
# everything but the wasmtime target by declaration.
#
# The composition fails on a resource-type mismatch, not on an unsatisfied
# import: `wac plug` leaves imports it cannot satisfy in place. `ecdsa-sign`
# does `use signature.{signing-key}`, and the provider *does* export
# `signature`, so plugging rebinds `signing-key` to the provider's own
# resource and orphans the `ecdsa-sign` import that still names the
# imported one. The enforcement therefore holds only while the provider
# exports the generic interface whose resource the withheld minting
# interface mints — true of every minting interface in the package today.
#
# Second: the same assertion for `rsa-oaep-decrypt`, which the signing
# suite cannot prove — its composition already fails on `ecdsa-sign`, so a
# provider that wrongly started exporting the OAEP decryption mints would
# still fail that composition for an unrelated reason. A dummy component
# of the minimal world importing only `rsa-oaep-decrypt`
# (../class-d/oaep-probe/wit; no Rust crate — `wasm-tools component embed
# --dummy` stubs the core) must fail the same way, on the
# `public-encryption` resources the provider's kind-only export rebinds.
#
# Matching each message on its interface name is load-bearing: a gate that
# accepted any nonzero exit would also pass on a missing artifact or a
# changed `wac` CLI.
class-d: build
    #!/usr/bin/env bash
    set -uo pipefail
    cargo build --manifest-path '{{root}}/Cargo.toml' --release \
        -p lann-webcrypto-guest-provider --target wasm32-wasip2
    output=$(wac plug {{signing}} \
        --plug '{{root}}/target/wasm32-wasip2/release/lann_webcrypto_guest_provider.wasm' \
        -o '{{root}}/target/class-d-composition.wasm' 2>&1)
    status=$?
    if [ $status -eq 0 ]; then
        echo "class-D gate: composing the signing suite with the in-guest provider SUCCEEDED." >&2
        echo "The provider must not export lann:webcrypto/ecdsa-sign (rust/guest-provider/wit/world.wit)." >&2
        exit 1
    fi
    if ! printf '%s' "$output" | grep -q 'lann:webcrypto/ecdsa-sign'; then
        echo "class-D gate: the composition failed, but not on ecdsa-sign:" >&2
        printf '%s\n' "$output" >&2
        exit 1
    fi
    echo "class-D gate: the signing suite does not compose with the in-guest provider (ecdsa-sign is not exported)."
    set -e
    wasm-tools component embed --dummy --features rsa-oaep-decrypt \
        -w oaep-probe ../class-d/oaep-probe/wit \
        -o '{{root}}/target/class-d-oaep-probe.core.wasm'
    wasm-tools component new '{{root}}/target/class-d-oaep-probe.core.wasm' \
        -o '{{root}}/target/class-d-oaep-probe.wasm'
    set +e
    output=$(wac plug '{{root}}/target/class-d-oaep-probe.wasm' \
        --plug '{{root}}/target/wasm32-wasip2/release/lann_webcrypto_guest_provider.wasm' \
        -o '{{root}}/target/class-d-oaep-composition.wasm' 2>&1)
    status=$?
    if [ $status -eq 0 ]; then
        echo "class-D gate: composing the rsa-oaep-decrypt probe with the in-guest provider SUCCEEDED." >&2
        echo "The provider must not export lann:webcrypto/rsa-oaep-decrypt (rust/guest-provider/wit/world.wit)." >&2
        exit 1
    fi
    if ! printf '%s' "$output" | grep -q 'lann:webcrypto/rsa-oaep-decrypt'; then
        echo "class-D gate: the OAEP probe composition failed, but not on rsa-oaep-decrypt:" >&2
        printf '%s\n' "$output" >&2
        exit 1
    fi
    echo "class-D gate: the rsa-oaep-decrypt probe does not compose with the in-guest provider (the OAEP decryption mints are not exported)."
