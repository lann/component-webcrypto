// The shared conformance guest world. One guest binary carries the whole
// cases and runs them against whichever `lann:webcrypto` implementation the
// target under test provides: the Wasmtime host, the jco host (Node and
// browser), or the composed in-guest provider.
//
// The `lann:webcrypto` package lives once at the repository root `wit/` and
// is pulled in through the `deps/lann-webcrypto` symlink.
package conformance:webcrypto@0.1.0;

/// The conformance suite as self-describing test cases.
///
/// Expectation policy lives in the cases, not in the harness. Each case
/// declares the `features` it exercises beyond the baseline surface every
/// implementation serves; a target declares only the features it is
/// `missing`. Feature tags are inert by default — a case runs everywhere
/// until a target opts out — so growing the suite never silently sheds
/// coverage: a target genuinely lacking the feature fails loudly until its
/// gap is recorded.
///
/// A case whose feature the target declares missing reports `skipped`
/// instead of exercising its subject; the feature-tagged *probe* cases
/// additionally assert the correct decline (for example, that every
/// minting path for the missing algorithm fails `unsupported`). The
/// assertion cuts both ways — a target that serves a feature it declares
/// missing, or declines one it doesn't, fails.
///
/// The feature names, and which target declares which missing, are
/// documented in conformance/README.md; the checked-in `tests.lock` files
/// pin each suite's case names and feature tags.
interface tests {
    /// The outcome of one executed test case.
    variant outcome {
        /// The observed behavior matched the expectation.
        pass,
        /// The observed behavior diverged; the payload says how.
        fail(string),
        /// The case's feature is declared missing by the target: the case
        /// asserted the correct decline instead of exercising its subject.
        /// The payload says what was asserted.
        skipped(string),
    }

    /// One conformance test case.
    resource test-case {
        /// Stable identity: `<algorithm>/<source>/<case>/<schedule>` for
        /// vector-driven cases (e.g. `aes-gcm/wycheproof/tc42/bytes`) or
        /// `probe/<name>` for hand-written API-contract probes.
        name: func() -> string;

        /// The feature names this case exercises beyond the baseline
        /// surface (empty for most cases).
        features: func() -> list<string>;

        /// Run the case. Expectation mismatches are reported as `fail`,
        /// never traps, so a run always yields an outcome.
        run: async func() -> outcome;
    }

    /// Materialize the suite for a target missing the named features, in
    /// suite order. Unknown feature names trap: a misspelled declaration
    /// is a harness bug, not a test outcome.
    all: func(missing-features: list<string>) -> list<test-case>;
}

world conformance-guest {

    export tests;
}

/// The host-only signing guest: probes for signature-minting interfaces the
/// in-guest provider deliberately does not export (`ecdsa-sign` is class D),
/// which the shared `conformance-guest` therefore cannot import — it must
/// compose with that provider. This world runs only under the host-backed
/// targets (wasmtime, jco); the composed target has no results for it.
world signing-guest {

    export tests;
}
