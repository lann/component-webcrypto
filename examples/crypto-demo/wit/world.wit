// Demo-only WIT for the `crypto-demo` example component. The shared
// `lann:webcrypto` package lives once at the repository root `wit/` and is
// pulled in through the `deps/lann-webcrypto` symlink.
package demo:webcrypto-demo@0.1.0;

/// The demo entry point exported by the component.
interface demo {
    /// Run the demo's known-answer and round-trip checks against the
    /// imported `lann:webcrypto` implementation. Returns a human-readable
    /// summary on success or a failure description.
    run: async func() -> result<string, string>;
}

/// A guest that exercises the `mac`, `aead`, `digest`, and `signature`
/// primitive kinds
/// end to end: HMAC-SHA-256 known-answer vectors, SHA-256 digests plus
/// `bytes.constant-time-equal`, and AES-256-GCM seal/open round trips,
/// including the key-capability surface (import/generate/export and
/// non-extractable keys).
world crypto-demo {

    export demo;
}
