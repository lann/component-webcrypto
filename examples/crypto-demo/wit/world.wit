// Demo-only WIT for the `crypto-demo` example component. The shared
// `lann:webcrypto` package lives once at the repository root `wit/`; this
// guest reaches it through `guest-sdk`'s bindings, so no `deps` copy is
// needed here.
package demo:webcrypto-demo@0.1.0;

/// The demo entry point exported by the component.
interface demo {
    /// Run the demo's known-answer and round-trip checks against the
    /// imported `lann:webcrypto` implementation. Returns a human-readable
    /// summary on success or a failure description.
    run: async func() -> result<string, string>;
}

/// A guest that exercises the package's primitive kinds end to end —
/// known-answer vectors, seal/open round trips, and the key-capability
/// surface (import/generate/export and non-extractable keys) — one check
/// per behavior; the check names in `src/lib.rs` are the inventory.
world crypto-demo {

    export demo;
}
