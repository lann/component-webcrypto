{
  "name": "@lann/jco-webcrypto-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "crypto-demo driver for the jco host (jco-impl/webcrypto.js): transpiles the guest with jco and runs it on Node 24+.",
  "scripts": {
    "build:component": "cd ../crypto-demo && cargo build --release --target wasm32-unknown-unknown && mkdir -p build && wasm-tools component new ../../target/wasm32-unknown-unknown/release/crypto_demo.wasm -o build/crypto-demo.component.wasm",
    "transpile": "jco transpile ../crypto-demo/build/crypto-demo.component.wasm --name crypto-demo --async-mode jspi --async-exports 'demo:webcrypto-demo/demo@0.1.0#run' --async-imports 'lann:webcrypto/hmac@0.1.0#import-hmac-sha256-key' --async-imports 'lann:webcrypto/hmac@0.1.0#generate-hmac-sha256-key' --async-imports 'lann:webcrypto/aes-gcm@0.1.0#import-key' --async-imports 'lann:webcrypto/aes-gcm@0.1.0#generate-key' --async-imports 'lann:webcrypto/mac@0.1.0#[method]mac-key.sign' --async-imports 'lann:webcrypto/mac@0.1.0#[method]mac-key.verify' --async-imports 'lann:webcrypto/mac@0.1.0#[method]mac-key.export' --async-imports 'lann:webcrypto/aead@0.1.0#[method]aead-key.seal' --async-imports 'lann:webcrypto/aead@0.1.0#[method]aead-key.open' --async-imports 'lann:webcrypto/aead@0.1.0#[method]aead-key.export' --map 'lann:webcrypto/mac@0.1.0=../../../jco-impl/webcrypto.js' --map 'lann:webcrypto/aead@0.1.0=../../../jco-impl/webcrypto.js' --map 'lann:webcrypto/hmac@0.1.0=../../../jco-impl/webcrypto.js' --map 'lann:webcrypto/aes-gcm@0.1.0=../../../jco-impl/webcrypto.js' -o generated",
    "start": "node --experimental-wasm-jspi src/run.mjs",
    "test": "node --experimental-wasm-jspi src/run.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.19.0"
  }
}
