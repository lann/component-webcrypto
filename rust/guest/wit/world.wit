// Bindings-only WIT for the `polymorph-webcrypto-guest` library crate. The
// shared `polymorph:webcrypto` package lives once at the repository root `wit/`
// and is pulled in through the `deps/polymorph-webcrypto` symlink.
package polymorph:webcrypto-guest;

/// The full `polymorph:webcrypto` import surface, bound once here and re-exported
/// to consumer components: a consumer that links this crate imports whatever
/// it actually calls (unused imports are stripped at componentization), so
/// most consumer worlds need no `polymorph:webcrypto` imports at all.
world imports {
    import polymorph:webcrypto/mac@0.1.0;
    import polymorph:webcrypto/aead@0.1.0;
    import polymorph:webcrypto/cipher@0.1.0;
    import polymorph:webcrypto/digest@0.1.0;
    import polymorph:webcrypto/sha2@0.1.0;
    @unstable(feature = sha1-checked)
    import polymorph:webcrypto/sha1-checked@0.1.0;
    import polymorph:webcrypto/hmac-sha2@0.1.0;
    import polymorph:webcrypto/hmac-sha1@0.1.0;
    import polymorph:webcrypto/aes-gcm@0.1.0;
    import polymorph:webcrypto/aes-cbc@0.1.0;
    import polymorph:webcrypto/aes-ctr@0.1.0;
    import polymorph:webcrypto/wrapping@0.1.0;
    import polymorph:webcrypto/key-wrap@0.1.0;
    import polymorph:webcrypto/aes-kw@0.1.0;
    import polymorph:webcrypto/derivation@0.1.0;
    import polymorph:webcrypto/hkdf@0.1.0;
    import polymorph:webcrypto/hkdf-sha2@0.1.0;
    import polymorph:webcrypto/hkdf-sha1@0.1.0;
    import polymorph:webcrypto/pbkdf2@0.1.0;
    import polymorph:webcrypto/pbkdf2-sha2@0.1.0;
    import polymorph:webcrypto/pbkdf2-sha1@0.1.0;
    import polymorph:webcrypto/key-agreement@0.1.0;
    import polymorph:webcrypto/x25519@0.1.0;
    import polymorph:webcrypto/ecdh@0.1.0;
    import polymorph:webcrypto/signature@0.1.0;
    import polymorph:webcrypto/ed25519-verify@0.1.0;
    import polymorph:webcrypto/ed25519-sign@0.1.0;
    import polymorph:webcrypto/ecdsa-verify@0.1.0;
    import polymorph:webcrypto/ecdsa-sign@0.1.0;
    import polymorph:webcrypto/rsassa-pkcs1-v15-verify@0.1.0;
    import polymorph:webcrypto/rsa-pss-verify@0.1.0;
    @unstable(feature = rsa-sign)
    import polymorph:webcrypto/rsassa-pkcs1-v15-sign@0.1.0;
    @unstable(feature = rsa-sign)
    import polymorph:webcrypto/rsa-pss-sign@0.1.0;
    import polymorph:webcrypto/public-encryption@0.1.0;
    import polymorph:webcrypto/rsa-oaep-encrypt@0.1.0;
    @unstable(feature = rsa-oaep-decrypt)
    import polymorph:webcrypto/rsa-oaep-decrypt@0.1.0;
}
