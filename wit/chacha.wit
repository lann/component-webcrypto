package lann:webcrypto@0.1.0;

/// ChaCha20-Poly1305 key minting (RFC 8439): the IETF construction, with
/// 12-byte nonces.
///
/// Keys minted here drive `aead.aead-key.seal`/`open` with the
/// `ciphertext ‖ tag` wire format.
///
/// Security:
/// - The 12-byte nonce space is too small to draw nonces at random.
///   Callers need a deterministic uniqueness scheme (such as a counter).
///   For random nonces, use `xchacha20-poly1305`; to stop managing nonces
///   entirely, use `xchacha20-poly1305-internal-nonce`.
///
/// The construction fixes both parameters: nonces are exactly 12 bytes
/// (`error.invalid-nonce` otherwise) and tags exactly 16 (a `tag-size`
/// other than `none` or 16 fails `error.unsupported`).
///
/// This interface and `xchacha20-poly1305` are deliberately separate (not a
/// variant enum): platform-backed providers systematically serve one
/// without the other (browser WebCrypto's proposed ChaCha support, Apple
/// CryptoKit, OpenSSL, and Conscrypt implement only the IETF construction,
/// while libsodium-lineage providers center XChaCha), so the support
/// boundary belongs at the interface, where a composition that needs the
/// missing one fails at composition time rather than at minting.
///
/// Gated `@unstable`: browser WebCrypto's ChaCha20-Poly1305 is a proposal
/// (W3C "Modern Algorithms in the Web Cryptography API"), and this
/// interface tracks it — the JWK contract already moved once to follow
/// the proposal's registered `"C20P"` (see `README.md`, "Stability
/// gates"). Consumers opt in by enabling the feature in their tooling.
@unstable(feature = chacha20-poly1305)
interface chacha20-poly1305 {
    @unstable(feature = chacha20-poly1305)
    use types.{error};
    @unstable(feature = chacha20-poly1305)
    use aead.{aead-key, aead-key-options};
    @unstable(feature = chacha20-poly1305)
    use wrapping.{unwrap-input};

    /// Import exactly 32 bytes of raw key material; anything else fails
    /// with `error.invalid-key`.
    @unstable(feature = chacha20-poly1305)
    import-key-raw: async func(raw: list<u8>, options: aead-key-options) -> result<aead-key, error>;

    /// Import a key from an RFC 7517 JSON Web Key. See `README.md`,
    /// "JWK contract".
    ///
    /// The accepted form is the `oct` JWK of the W3C Modern Algorithms
    /// proposal: `kty` must be `"oct"` and `k` must decode to exactly 32
    /// bytes. `alg`, when present, must be the proposal's registered
    /// `"C20P"`; any other value fails with `error.invalid-key`.
    @unstable(feature = chacha20-poly1305)
    import-key-jwk: async func(jwk: string, options: aead-key-options) -> result<aead-key, error>;

    /// Generate a fresh random 256-bit key.
    @unstable(feature = chacha20-poly1305)
    generate-key: async func(options: aead-key-options) -> result<aead-key, error>;

    /// Mint a key from unwrapped key material (see the `wrapping`
    /// interface): `input`'s bytes are read as raw key material, subject
    /// to `import-key-raw`'s contract. `input` is consumed.
    ///
    /// The minted key's usages and extractability come from `options`
    /// alone (the W3C Web Cryptography API's `unwrapKey` model).
    @unstable(feature = chacha20-poly1305)
    unwrap-key-raw: async func(input: unwrap-input, options: aead-key-options) -> result<aead-key, error>;

    /// Mint a key from unwrapped key material read as an RFC 7517 JSON
    /// Web Key, subject to `import-key-jwk`'s contract. `input` is
    /// consumed.
    @unstable(feature = chacha20-poly1305)
    unwrap-key-jwk: async func(input: unwrap-input, options: aead-key-options) -> result<aead-key, error>;
}

/// XChaCha20-Poly1305 key minting (draft-irtf-cfrg-xchacha, as deployed
/// ubiquitously by libsodium): the extended-nonce construction, with
/// 24-byte nonces — large enough to be chosen at random. Not
/// IETF-standardized.
///
/// Keys minted here drive `aead.aead-key.seal`/`open` with the
/// `ciphertext ‖ tag` wire format; nonces are exactly 24 bytes and tags
/// exactly 16, as in `chacha20-poly1305`. See `chacha20-poly1305` for why
/// the two constructions are separate interfaces rather than a variant
/// enum.
///
/// There is no JWK minting or export for this construction: no
/// specification registers a JWK form for it (`chacha20-poly1305`'s
/// `"C20P"` form is the W3C Modern Algorithms proposal's), so
/// `aead-key.export-key-jwk` fails `error.unsupported` for keys minted
/// here.
///
/// Gated `@unstable`: the construction is deployed but not
/// IETF-standardized, and no platform WebCrypto serves it (see
/// `README.md`, "Stability gates"). Consumers opt in by enabling the
/// feature in their tooling.
@unstable(feature = xchacha20-poly1305)
interface xchacha20-poly1305 {
    @unstable(feature = xchacha20-poly1305)
    use types.{error};
    @unstable(feature = xchacha20-poly1305)
    use aead.{aead-key, aead-key-options};
    @unstable(feature = xchacha20-poly1305)
    use wrapping.{unwrap-input};

    /// Import exactly 32 bytes of raw key material; anything else fails
    /// with `error.invalid-key`.
    @unstable(feature = xchacha20-poly1305)
    import-key-raw: async func(raw: list<u8>, options: aead-key-options) -> result<aead-key, error>;

    /// Generate a fresh random 256-bit key.
    @unstable(feature = xchacha20-poly1305)
    generate-key: async func(options: aead-key-options) -> result<aead-key, error>;

    /// Mint a key from unwrapped key material read as raw bytes, subject
    /// to `import-key-raw`'s contract. `input` is consumed; see
    /// `chacha20-poly1305.unwrap-key-raw` for the options model. There is
    /// no JWK counterpart, as there is no JWK minting here.
    @unstable(feature = xchacha20-poly1305)
    unwrap-key-raw: async func(input: unwrap-input, options: aead-key-options) -> result<aead-key, error>;
}

/// XChaCha20-Poly1305 internal-nonce key minting: `aead-internal-nonce`
/// keys drawing a fresh random 24-byte nonce per seal.
///
/// Sealed messages are `nonce ‖ ciphertext ‖ tag` (24-byte nonce, 16-byte
/// tag).
///
/// This is the recommended internal-nonce algorithm: at 24 bytes the nonce
/// repeat probability is negligible for any realistic invocation count, so
/// there is no practical nonce budget (implementations still MAY signal
/// `error.key-exhausted` under an explicit policy). There is deliberately
/// no IETF-ChaCha20-Poly1305 internal-nonce interface: the internal-nonce
/// wire format is this package's own, so nothing forces the 12-byte
/// construction here, and every provider position is better served by this
/// interface or `aes-gcm-internal-nonce`.
///
/// Gated `@unstable` with `xchacha20-poly1305`, whose construction and
/// standardization status it shares (see `README.md`, "Stability gates").
@unstable(feature = xchacha20-poly1305)
interface xchacha20-poly1305-internal-nonce {
    @unstable(feature = xchacha20-poly1305)
    use types.{error};
    @unstable(feature = xchacha20-poly1305)
    use aead-internal-nonce.{internal-nonce-key, internal-nonce-key-options};
    @unstable(feature = xchacha20-poly1305)
    use wrapping.{unwrap-input};

    /// Import exactly 32 bytes of raw key material as an internal-nonce
    /// key; anything else fails with `error.invalid-key`. See
    /// `aes-gcm-internal-nonce.import-key-raw` for the shared-material caveat
    /// and policy-rejection allowance, which apply identically here.
    @unstable(feature = xchacha20-poly1305)
    import-key-raw: async func(raw: list<u8>, options: internal-nonce-key-options) -> result<internal-nonce-key, error>;

    /// Generate a fresh random internal-nonce key.
    @unstable(feature = xchacha20-poly1305)
    generate-key: async func(options: internal-nonce-key-options) -> result<internal-nonce-key, error>;

    /// Mint an internal-nonce key from unwrapped key material read as
    /// raw bytes, subject to `import-key-raw`'s contract — including the
    /// shared-material caveat and policy-rejection allowance. `input` is
    /// consumed; see `chacha20-poly1305.unwrap-key-raw` for the options
    /// model.
    @unstable(feature = xchacha20-poly1305)
    unwrap-key-raw: async func(input: unwrap-input, options: internal-nonce-key-options) -> result<internal-nonce-key, error>;
}
